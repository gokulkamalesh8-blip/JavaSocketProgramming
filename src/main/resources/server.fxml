    <TextArea fx:id="server_text_area" layoutX="14.0" layoutY="14.0" prefHeight="320.0" prefWidth="572.0" />
    <TextField fx:id="server_text_field" layoutX="14.0" layoutY="350.0" prefHeight="30.0" prefWidth="470.0" />
    <Button fx:id="server_send_btn" layoutX="500.0" layoutY="350.0" mnemonicParsing="false" onAction="#sendMessage" prefHeight="30.0" prefWidth="86.0" text="Send" />
</AnchorPane>