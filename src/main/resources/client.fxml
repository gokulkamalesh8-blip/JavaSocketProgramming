<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ClientController">
    <TextArea fx:id="client_text_area" editable="false" layoutX="14.0" layoutY="14.0" prefHeight="320.0"
              prefWidth="572.0"/>
    <TextField fx:id="client_text_field" layoutX="14.0" layoutY="350.0" prefHeight="30.0" prefWidth="370.0"/>
    <Button fx:id="client_send_btn" layoutX="400.0" layoutY="350.0" mnemonicParsing="false" onAction="#sendMessage"
            prefHeight="30.0" prefWidth="86.0" text="Send"/>
    <Button fx:id="emoji_btn" layoutX="14.0" layoutY="395.0" mnemonicParsing="false" onAction="#showEmojiPicker"
            prefHeight="30.0" prefWidth="86.0" text="Emoji"/>
    <Button fx:id="send_file_btn" layoutX="110.0" layoutY="395.0" mnemonicParsing="false" onAction="#sendFile"
            prefHeight="30.0" prefWidth="86.0" text="Send File"/>
</AnchorPane>